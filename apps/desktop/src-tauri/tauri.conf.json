{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDMXL",
  "version": "0.1.0",
  "identifier": "dev.idmxl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IDMXL",
        "width": 1240,
        "height": 850,
        "minWidth": 750,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/idmxl"],
    "resources": {"../../../extensions/edge/": "browser-extension/", "../../../scripts/browser-host.ps1":"browser-host.ps1", "../../../docs/BROWSER-HANDOFF.md":"BROWSER-HANDOFF.md"},
    "windows": {
      "nsis": {"installMode":"currentUser","languages":["English"],"displayLanguageSelector":false},
      "webviewInstallMode": {"type":"downloadBootstrapper","silent":true}
    }
  }
}
