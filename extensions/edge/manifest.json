{
  "manifest_version": 3,
  "name": "IDMXL — Downloads",
  "version": "0.1.3",
  "description": "Download with IDMXL. Optional automatic capture handles supported downloads over 1 MB across websites.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": ["downloads", "webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "IDMXL handoff" }
}
